<!DOCTYPE html>
<html lang="hi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>VikasMart — Shop Smart. Live Better.</title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 text-gray-800">

  <!-- Top Header Banner -->
  <div class="bg-orange-600 text-white text-xs py-1.5 px-4 text-center font-medium">
    🔥 Flash Sale! Use coupon <span class="font-bold underline">WELCOME10</span> for 10% OFF!
  </div>

  <!-- Header -->
  <header class="bg-white shadow-sm sticky top-0 z-50">
    <div class="max-w-7xl mx-auto px-4 py-3 flex items-center justify-between">
      <div class="flex items-center gap-2">
        <span class="bg-orange-600 text-white font-black text-xl px-2.5 py-0.5 rounded">V</span>
        <span class="font-bold text-2xl tracking-tight text-gray-900">
          Vikas<span class="text-orange-600">Mart</span>
        </span>
      </div>

      <!-- Search Bar -->
      <div class="hidden md:flex flex-1 max-w-md mx-6">
        <input 
          type="text" 
          placeholder="Search products..." 
          class="w-full px-4 py-1.5 text-sm border border-gray-300 rounded-l-lg focus:outline-none focus:ring-1 focus:ring-orange-500"
        >
        <button class="bg-orange-600 text-white px-4 text-sm font-bold rounded-r-lg hover:bg-orange-700">
          Search
        </button>
      </div>

      <!-- Cart Button -->
      <div>
        <button onclick="toggleCartModal()" class="bg-gray-900 text-white text-xs font-bold px-4 py-2 rounded-lg flex items-center gap-2 hover:bg-orange-600 transition-colors">
          🛒 Cart (<span id="cart-count">0</span>)
        </button>
      </div>
    </div>
  </header>

  <!-- Hero Banner -->
  <section class="bg-gradient-to-r from-gray-900 to-orange-950 text-white py-12 px-4">
    <div class="max-w-7xl mx-auto text-center md:text-left flex flex-col md:flex-row items-center justify-between gap-6">
      <div>
        <h1 class="text-3xl md:text-5xl font-black mb-3">Big Deals. Better Prices.</h1>
        <p class="text-gray-300 text-sm mb-4">Discover high-quality items delivered straight to your doorstep across India.</p>
        <a href="#products" class="inline-block bg-orange-600 hover:bg-orange-700 text-white font-bold px-6 py-2.5 rounded-lg text-sm">Shop Now</a>
      </div>
    </div>
  </section>

  <!-- Products Section -->
  <main id="products" class="max-w-7xl mx-auto px-4 py-10">
    <h2 class="text-xl font-bold text-gray-900 mb-6">Featured Products</h2>
    <div id="product-grid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4">
      <!-- Dynamic Products Inserted Here via JS -->
    </div>
  </main>

  <!-- Footer -->
  <footer class="bg-gray-900 text-gray-400 py-6 text-center text-xs">
    <p>© 2026 VikasMart — Shop Smart. Live Better.</p>
  </footer>

  <!-- JavaScript logic for Cart and Products -->
  <script>
    const products = [
      {
        id: 1,
        name: "Wireless Bluetooth Headphones",
        price: 1999,
        originalPrice: 3999,
        category: "Electronics",
        image: "https://images.unsplash.com/photo-1505740420928-5e560c06d30e?w=500&q=80"
      },
      {
        id: 2,
        name: "Smart Fitness Watch",
        price: 2499,
        originalPrice: 4999,
        category: "Electronics",
        image: "https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=500&q=80"
      },
      {
        id: 3,
        name: "Classic Men's Casual Shirt",
        price: 799,
        originalPrice: 1999,
        category: "Fashion",
        image: "https://images.unsplash.com/photo-1602810318383-e386cc2a3ccf?w=500&q=80"
      }
    ];

    let cart = [];

    function renderProducts() {
      const container = document.getElementById('product-grid');
      container.innerHTML = products.map(p => `
        <div class="bg-white p-4 rounded-xl border border-gray-200 shadow-sm flex flex-col justify-between">
          <div>
            <img src="${p.image}" alt="${p.name}" class="h-40 w-full object-contain mb-3 rounded">
            <span class="text-[10px] text-gray-400 uppercase font-bold tracking-wider">${p.category}</span>
            <h3 class="text-sm font-semibold text-gray-800 line-clamp-2">${p.name}</h3>
          </div>
          <div class="mt-3">
            <div class="flex items-baseline gap-2 mb-3">
              <span class="text-base font-bold text-gray-900">₹${p.price}</span>
              <span class="text-xs text-gray-400 line-through">₹${p.originalPrice}</span>
            </div>
            <button onclick="addToCart(${p.id})" class="w-full bg-orange-600 hover:bg-orange-700 text-white text-xs font-bold py-2 rounded-lg transition-colors">
              Add to Cart
            </button>
          </div>
        </div>
      `).join('');
    }

    function addToCart(productId) {
      const item = products.find(p => p.id === productId);
      cart.push(item);
      document.getElementById('cart-count').innerText = cart.length;
      alert(`${item.name} को कार्ट में जोड़ दिया गया है!`);
    }

    // Initial Render
    renderProducts();
  </script>
</body>
</html>
